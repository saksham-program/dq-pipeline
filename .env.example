# Copy to .env and fill in the values from your Supabase project
# (Project Settings -> API). Never commit real secrets.

# Browser (Vite) — public values, inlined at build time
VITE_SUPABASE_URL="https://<your-project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"

# Server-side (SSR / server functions)
SUPABASE_URL="https://<your-project-ref>.supabase.co"
SUPABASE_PUBLISHABLE_KEY="<your-publishable-key>"

# Optional: only needed by the server-only admin client (src/integrations/supabase/client.server.ts).
# Keep this secret; never expose it to the browser.
# SUPABASE_SERVICE_ROLE_KEY=""

# Optional: only needed for `drizzle-kit` (Postgres connection string)
# DB_MIGRATION_URL="postgresql://postgres:<password>@db.<your-project-ref>.supabase.co:5432/postgres"

# Optional: only needed if you wire up src/integrations/supabase/cron-auth.ts
# CRON_SECRET=""

# Optional. Automatic "Fresh Demo Workspace" resets only run under `vite dev`. Set to "true" to also allow them in a
# production build (e.g. a local `vite preview` demo). Leave unset anywhere real data lives.
# VITE_DEMO_AUTO_RESET="true"
