# Browser-visible configuration. Use only the existing publishable/anon key.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
# Retained project metadata; not required by application call sites.
VITE_SUPABASE_PROJECT_ID=your-project-id

# Server configuration for the same existing database. Never use VITE_ for secrets.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-publishable-key
SUPABASE_PROJECT_ID=your-project-id

# Optional: on = disposable memory, off = persistent database.
# Leaving unset preserves hostname-based behavior.
# VITE_DQ_DEMO_RESET=on

# Optional only for trusted server admin code (no current application caller).
# SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Existing migration tooling variable; never commit a real connection URL.
# LOVABLE_DB_MIGRATION_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Retained cron helper has no current caller; do not configure unless used.
# LOVABLE_CRON_SECRET=your-server-only-cron-secret
# LOVABLE_CRON_SECRET_PREVIOUS=your-previous-server-only-cron-secret
